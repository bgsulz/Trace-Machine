FLASK_APP=run.py
FLASK_DEBUG=1

DATABASE_URL=postgresql://postgres@localhost/veracity_db
LIMITER_STORAGE_URL=memory://
SECRET_KEY=replace-me

PROXY_FIX_ENABLED=true
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
# Set to 1 if your proxy rewrites Host and sends X-Forwarded-Host.
PROXY_FIX_X_HOST=0

# Local development only: let URL analysis and remote C2PA manifests reach
# private/LAN addresses. Never enable in production (server-side request forgery).
# SAFE_FETCH_ALLOW_PRIVATE=false

# Invisible watermark decoders. Unset = Adobe TrustMark (needs onnxruntime).
# Models (~95 MB) download on first use, or ahead of time: flask download-models
# INVISIBLE_WATERMARK_DECODERS=trustmark     # or: none, all, imwatermark
# TRUSTMARK_THREADS=2
# TRUSTMARK_AUTO_DOWNLOAD=true   # fetch missing models in the background

# Optional: enables the on-demand "Check automatically" button for OpenAI's
# provenance API (C2PA + SynthID). Images are sent to OpenAI when a visitor
# clicks; pricing isn't published, so set a spend cap on the key.
# OPENAI_API_KEY=

KOFI_TOKEN=replace-me
SERPAPI_KEY=replace-me
